# Authentication Messages
msgid "User registered successfully."
msgstr "کاربر با موفقیت ثبت نام شد."

msgid "OTP sent successfully."
msgstr "کد تایید با موفقیت ارسال شد."

msgid "OTP expired or not found."
msgstr "کد تایید منقضی شده یا یافت نشد."

msgid "Invalid OTP code."
msgstr "کد تایید نامعتبر است."

msgid "Invalid OTP format."
msgstr "فرمت کد تایید نامعتبر است."

msgid "Password reset OTP sent successfully."
msgstr "کد بازیابی رمز عبور با موفقیت ارسال شد."

msgid "Password has been reset successfully."
msgstr "رمز عبور با موفقیت بازیابی شد."

msgid "This account has been deactivated."
msgstr "این حساب کاربری غیرفعال شده است."

msgid "Login failed."
msgstr "ورود ناموفق بود."

msgid "Phone number must include country code (e.g. +98...)"
msgstr "شماره تلفن باید شامل کد کشور باشد (مثال: +98...)"

msgid "Invalid phone number format."
msgstr "فرمت شماره تلفن نامعتبر است."

msgid "Passwords do not match."
msgstr "رمزهای عبور مطابقت ندارند."

msgid "Password must be at least 8 characters long."
msgstr "رمز عبور باید حداقل 8 کاراکتر باشد."

msgid "Password reset failed."
msgstr "بازیابی رمز عبور ناموفق بود."

msgid "If an account with this mobile exists, an OTP has been sent."
msgstr "اگر حساب کاربری با این شماره وجود داشته باشد، کد تایید ارسال شده است."

msgid "Invalid credentials."
msgstr "اطلاعات ورود نامعتبر است."

# Course Messages
msgid "Course not found."
msgstr "دوره یافت نشد."

msgid "Category not found."
msgstr "دسته‌بندی یافت نشد."

msgid "Instructor not found."
msgstr "مدرس یافت نشد."

# Purchase / Cart Messages
msgid "Your cart is empty."
msgstr "سبد خرید شما خالی است."

msgid "No items found in your cart."
msgstr "هیچ آیتمی در سبد خرید شما وجود ندارد."

msgid "Course already purchased."
msgstr "این دوره قبلاً خریداری شده است."

msgid "Course already in cart."
msgstr "این دوره قبلاً به سبد خرید اضافه شده است."

msgid "Course added to cart."
msgstr "دوره به سبد خرید اضافه شد."

msgid "Payment successful."
msgstr "پرداخت با موفقیت انجام شد."

msgid "Each course must have at least one participant."
msgstr "هر دوره باید حداقل یک شرکت‌کننده داشته باشد."

msgid "No participants provided for course {course_id}."
msgstr "شرکت‌کننده‌ای برای دوره {course_id} ارسال نشده است."

msgid "Course {course_id} is not in your cart."
msgstr "دوره {course_id} در سبد خرید شما وجود ندارد."

msgid "Invalid discount code."
msgstr "کد تخفیف نامعتبر است."

msgid "Discount code is not valid for this course."
msgstr "کد تخفیف برای این دوره معتبر نیست."

msgid "Discount code is invalid or does not meet usage conditions."
msgstr "کد تخفیف نامعتبر است یا شرایط استفاده را ندارد."

msgid "code and course_id are required."
msgstr "کد تخفیف و شناسه دوره الزامی هستند."

# Ticket Messages
msgid "Ticket not found."
msgstr "تیکت یافت نشد."

msgid "You do not have permission to reply to this ticket."
msgstr "شما اجازه پاسخ به این تیکت را ندارید."

msgid "Reply posted successfully."
msgstr "پاسخ با موفقیت ثبت شد."

msgid "Ticket created successfully."
msgstr "تیکت با موفقیت ایجاد شد."

msgid "Ticket updated successfully."
msgstr "تیکت با موفقیت به‌روزرسانی شد."

# Notification Messages
msgid "Notification marked as read."
msgstr "اعلان به عنوان خوانده شده علامت‌گذاری شد."

