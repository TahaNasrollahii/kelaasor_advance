msgstr "آنلاین"

msgid "Offline"
msgstr "آفلاین"

msgid "Pending"
msgstr "در انتظار"

msgid "Paid"
msgstr "پرداخت شده"

msgid "Failed"
msgstr "ناموفق"

msgid "Open"
msgstr "باز"

msgid "In Progress"
msgstr "در حال بررسی"

msgid "Closed"
msgstr "بسته شده"

msgid "Support"
msgstr "پشتیبانی"

msgid "Finance"
msgstr "مالی"

msgid "Education"
msgstr "آموزش"

msgid "Percent"
msgstr "درصدی"

msgid "Fixed Amount"
msgstr "مقدار ثابت"

msgid "Order"
msgstr "سفارش"

msgid "Ticket"
msgstr "تیکت"

msgid "Discount"
msgstr "تخفیف"

msgid "System"
msgstr "سیستم"

# Model Help Texts
msgid "Access duration after purchase (days)"
msgstr "مدت دسترسی بعد از خرید (روز)"

msgid "Video duration in minutes"
msgstr "مدت ویدیو به دقیقه"

msgid "Maximum number of times this code can be used"
msgstr "حداکثر تعداد استفاده از این کد"

msgid "Restricted to a specific user"
msgstr "محدود به یک کاربر خاص"

msgid "Restricted to a specific course"
msgstr "محدود به یک دوره خاص"

# Email Templates
#, python-brace-format
msgid "New reply for your ticket: {title}"
msgstr "پاسخ جدید برای تیکت شما: {title}"

#, python-brace-format
msgid "Hello {name},\n\nYour ticket has been replied to:\n\n{message}\n\nPlease log in to view the full conversation."
msgstr "سلام {name},\n\nتیکت شما پاسخ داده شد:\n\n{message}\n\nبرای مشاهده کامل، وارد پنل خود شوید."

#, python-brace-format
msgid "Your ticket has been replied to: {title}\n{message}"
msgstr "تیکت شما پاسخ داده شد: {title}\n{message}"
